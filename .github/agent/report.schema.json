{
  "title": "TestAgentReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decisions", "skillsUsed", "filesChanged", "results", "notes"],
  "properties": {
    "summary": { "type": "string", "maxLength": 600 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "action", "reason"],
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["create", "update", "skip"] },
          "testFile": { "type": "string" },
          "reason": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "skillsUsed": { "type": "array", "items": { "type": "string" } },
    "filesChanged": { "type": "array", "items": { "type": "string" } },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend"],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran"],
          "properties": {
            "ran": { "type": "boolean" },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "coverageLinesBefore": { "type": "number" },
            "coverageLinesAfter": { "type": "number" }
          }
        },
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ran"],
          "properties": {
            "ran": { "type": "boolean" },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "coverageLinesBefore": { "type": "number" },
            "coverageLinesAfter": { "type": "number" }
          }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string", "maxLength": 500 } }
  }
}
